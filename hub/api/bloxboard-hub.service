[Unit]
Description=Bloxboard community hub API
After=network-online.target
Wants=network-online.target

[Service]
User=bloxboard
EnvironmentFile=/etc/bloxboard-hub.env
WorkingDirectory=/opt/bloxboard-hub
ExecStart=/opt/bloxboard-hub/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8790 --proxy-headers --forwarded-allow-ips 192.168.2.100
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bloxboard-hub
PrivateTmp=true

[Install]
WantedBy=multi-user.target

{
  "manifest_version": 3,
  "name": "Bloxboard",
  "version": "0.3.0",
  "description": "Free Roblox companion: server browser with regions, player finder, playtime, trade values, friends and a dashboard.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open Bloxboard",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://www.rolimons.com/*",
    "https://api.rolimons.com/*",
    "https://ipwho.is/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*games/*"
      ],
      "js": [
        "lib.js",
        "content/common.js",
        "content/game.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.roblox.com/*users/*/profile*"
      ],
      "js": [
        "lib.js",
        "content/common.js",
        "content/profile.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.roblox.com/home*",
        "https://www.roblox.com/*/home*"
      ],
      "js": [
        "lib.js",
        "content/common.js",
        "content/home.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.roblox.com/catalog/*",
        "https://www.roblox.com/*/catalog/*"
      ],
      "js": [
        "lib.js",
        "content/common.js",
        "content/item.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "lib.js",
        "content/common.js",
        "content/search.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.roblox.com/trades*",
        "https://www.roblox.com/*/trades*",
        "https://www.roblox.com/users/*/trade*",
        "https://www.roblox.com/*/users/*/trade*"
      ],
      "js": [
        "lib.js",
        "content/common.js",
        "content/trade.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "update_url": "https://bloxboard.enesserver.dev/updates.xml",
  "homepage_url": "https://bloxboard.enesserver.dev"
}